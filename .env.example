# ==============================================
# AWS Bedrock AI Gateway - Environment Config
# ==============================================

# Project & Environment
ENVIRONMENT=development
PROJECT_NAME="Bedrock AI Gateway"

# Security & JWT
SECRET_KEY=change-this-in-production-use-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Database (Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/bedrock_gateway

# Redis Cache & Rate Limiter
REDIS_URL=redis://localhost:6379/0

# AWS Credentials (Optional in local dev if using mock mode; in ECS Fargate, IAM Task Roles are used automatically)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_key
AWS_SECRET_ACCESS_KEY=mock_secret
S3_BUCKET_NAME=bedrock-gateway-artifacts-dev

# Stripe Payments & Billing
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Initial Superadmin Account
ADMIN_EMAIL=admin@bedrockgateway.com
ADMIN_PASSWORD=AdminPassword123!

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
